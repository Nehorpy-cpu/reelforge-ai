# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Persistent SQLite database and generated artifacts directory.
DATA_DIR="data"
PORT="3000"
TRUST_PROXY="0"
# Leave empty to enable automatically in production. Use false only for local HTTP tests.
COOKIE_SECURE=""

# Bancard vPOS 2.0. Use the sandbox URL until Bancard certifies the commerce.
BANCARD_PUBLIC_KEY=""
BANCARD_PRIVATE_KEY=""
BANCARD_BASE_URL="https://vpos.infonet.com.py:8888"
BANCARD_CHECKOUT_SCRIPT=""
BANCARD_AMOUNT_STARTER="299000"
BANCARD_AMOUNT_GROWTH="749000"
BANCARD_AMOUNT_AGENCY="1890000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
